# Copy to .env (git-ignored) and fill in; every script reads it at start.
# A variable already set in the shell wins over this file.

# Weights & Biases: https://wandb.ai/authorize
WANDB_API_KEY=
# Your wandb user or team; empty: the account's default.
WANDB_ENTITY=

# Hugging Face, for private datasets and for export_policy.py repo_id=...:
# https://huggingface.co/settings/tokens
HF_TOKEN=
